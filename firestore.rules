rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function section()  { return request.auth.token.section; }
    function isAdmin()  { return signedIn() && role() == 'admin'; }

    // An account an administrator has approved and not disabled. Claims are the
    // proof: onUserDocWrite mints role/section ONLY for such an account and
    // strips them again the moment it is left pending, declined or disabled, so
    // a self-registered account can sign in from the moment it is created and
    // still read nothing at all until it is granted. Every collection below is
    // gated on this rather than on signedIn(), which now means no more than
    // "holds a sign-in".
    function approved() {
      return signedIn() && (role() == 'admin' || role() == 'officer');
    }

    // ---------------------------------------------------------------------
    // Who sees what. Every account works from one of three places, and the
    // partition below mirrors lib/rules/access.ts exactly:
    //
    //  - the DEPARTMENT: an administrator, or the cross-section 'All' posting.
    //    Reads and writes everything.
    //  - a SECTION: an ordinary officer. Reads the collections their section
    //    works in, writes their section's records, and sees only their own
    //    section's rows of the shared daily log.
    //  - an INLAND OFFICE: an NSSS officer posted to a border post (the
    //    `border` claim). Their job is scanning trucks, so they may read and
    //    write their own post's scans and screening figures and nothing else —
    //    no register, no licensing, no inspections, no reports.
    // ---------------------------------------------------------------------

    // The inland office an account files screening figures against, or '' when
    // it may file for any (head office, 'All', an administrator). An NSSS
    // officer posted to one office may not enter figures for another — that is
    // what makes the national screening total the sum of the offices.
    function postedOffice() { return request.auth.token.get('border', ''); }
    function posted() { return postedOffice() != ''; }
    function filesFor(office) {
      return postedOffice() == '' || office == postedOffice();
    }
    // A daily entry a posted officer writes must name their own post; anyone
    // else may file with or without one.
    function filedAtOwnPost(d) {
      return !posted() || (('border' in d) && d.border == postedOffice());
    }

    // Approved, and not confined to a border post. An administrator is never
    // confined, whatever claims they carry.
    function atHeadOffice() {
      return approved() && (isAdmin() || !posted());
    }
    function inSection(name) {
      return section() == name || section() == 'All' || isAdmin();
    }

    function isAS()   { return atHeadOffice() && inSection('Authorisation & Standards'); }
    function isInsp() { return atHeadOffice() && inSection('Inspectorate'); }
    function isNSI()  { return atHeadOffice() && inSection('National Source Inventory'); }
    // NSSS at head office — runs the section: the border register, the
    // official daily totals, the section's dashboard.
    function isNSSSDesk() {
      return atHeadOffice() && inSection('Nuclear Safety, Security & Safeguards');
    }
    // Any NSSS officer, posted ones included — the ones who log scans.
    function isNSSS() {
      return approved() && inSection('Nuclear Safety, Security & Safeguards');
    }
    // The facilities register and everything hung off it (licences,
    // inspections, applications, the licensing <-> inspectorate handoff) is
    // Licensing's and the Inspectorate's. The other sections keep their own
    // registers and never read it.
    function seesRegister() { return isAS() || isInsp(); }

    function validFacility(d) {
      return d.name is string && d.name.size() > 0
        && d.province in ['Lusaka','Copperbelt','North-Western','Central','Northern',
                          'Luapula','Eastern','Western','Southern','Muchinga']
        && d.sector in ['Public','Private']
        && d.licensed is bool
        && d.stage is string
        // 2026 status-list fields — optional for docs written before them.
        && (!('functional' in d) || d.functional is bool)
        && (!('category' in d) || d.category in ['Medical','Non-Medical'])
        && (!('stalled' in d) || d.stalled is bool)
        && (!('needsReview' in d) || d.needsReview is bool);
    }

    function validEvent(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type is string
        && d.facilityName is string;
    }

    function validInspection(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.outcome in ['Compliant','Minor findings','Major findings','Non-compliant','N/A']
        // Inspection-database columns — optional for docs written before them.
        // The enforcement vocabulary is the Inspectorate workbook's own list
        // (its "License" spelling included), so the summary's columns and the
        // stored values stay one controlled set.
        && (!('enforcement' in d) || d.enforcement in [
             'Engagement at Facility Level','Engagement at District Level',
             'Engagement at Provincial Level','Seizure of Device',
             'Suspension of Practice','Written Warning','Enforcement Notice',
             'Suspension of License','Cancellation of License'])
        && (!('cardIssued' in d)
             || d.cardIssued.matches('\\d{4}-\\d{2}-\\d{2}'))
        && (!('phase' in d) || (d.phase is string && d.phase.size() <= 40))
        && (!('district' in d) || d.district is string)
        && (!('practice' in d) || d.practice is string);
    }

    function validInspectionRequest(d) {
      return d.facilityName is string && d.facilityName.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.status in ['Requested','Acknowledged','Assigned','In Progress',
                        'Report Ready','Closed','Cancelled']
        && d.timeline is list;
    }

    match /facilities/{id} {
      allow read:   if seesRegister();
      allow create: if isAS() && validFacility(request.resource.data);
      allow update: if isAS() && validFacility(request.resource.data);
      allow delete: if isAdmin();
    }

    match /licenceEvents/{id} {
      allow read:   if seesRegister();
      allow create: if isAS() && validEvent(request.resource.data);
      allow update: if isAS() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inspections/{id} {
      allow read:   if seesRegister();
      allow create: if isInsp() && validInspection(request.resource.data);
      allow update: if isInsp() && validInspection(request.resource.data);
      allow delete: if isAdmin();
    }

    // Cross-section inspection requests: the Licensing (A&S) ↔ Inspectorate
    // handoff. Either section collaborates on the same document — Licensing
    // raises it and closes it once the report is actioned; the Inspectorate
    // acknowledges, assigns, progresses and completes it — so both may write,
    // guarded by a shape check. History (deletes) stays admin-only.
    match /inspectionRequests/{id} {
      allow read:   if seesRegister();
      allow create: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow update: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    // RAIS licensing-status tracker: imported on the Smart Status Update tab by
    // Authorisation & Standards officers; readable by the two sections that
    // work the register.
    //
    // The `notes` trail (officer comments + automatic status history) is the
    // shared memory on an application — awareness between Licensing and the
    // Inspectorate is its point — so either section may APPEND to it: the
    // write may touch nothing but notes/updatedAt/updatedBy and may never
    // shrink the trail. Everything else on the record stays A&S-only.
    function notesAppendOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notes', 'updatedAt', 'updatedBy'])
        && request.resource.data.notes is list
        && (!('notes' in resource.data)
            || request.resource.data.notes.size() >= resource.data.notes.size());
    }

    match /licenceWorkflows/{id} {
      allow read:   if seesRegister();
      allow create: if isAS() && request.resource.data.ran is string;
      allow update: if (isAS() && request.resource.data.ran is string)
        || (seesRegister() && notesAppendOnly());
      allow delete: if isAdmin();
    }

    // Daily section log (Daily Updates tab). An officer logs their own
    // section's day — a numeric count against one of its metrics, or a
    // free-text note. Entries carry the reporting week so they roll straight up
    // into the weekly report. Owners may edit/remove their own lines (updatedBy
    // is the audit trail and may never be reassigned); admins may do anything.
    //
    // Reads are partitioned the same way: the department reads the whole log,
    // a section its own entries, a posted officer their post's. A list query
    // from a section account must therefore filter on section (and, when
    // posted, on border) or it is refused outright — see listDailyEntries.
    function validDailyEntry(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.section in ['Authorisation & Standards','Inspectorate',
                         'Nuclear Safety, Security & Safeguards','National Source Inventory']
        && d.kind in ['count','note'];
    }
    function ownSectionEntry(d) {
      return isAdmin() || section() == 'All' || d.section == section();
    }

    match /dailyEntries/{id} {
      allow read: if approved()
        && ownSectionEntry(resource.data)
        && filesFor(resource.data.get('border', ''));
      allow create: if approved()
        && validDailyEntry(request.resource.data)
        && ownSectionEntry(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        // A coordinator posted to one inland office posts that office's
        // figure and no other's.
        && filedAtOwnPost(request.resource.data);
      allow update:
        if isAdmin() || (approved()
          && validDailyEntry(request.resource.data)
          && ownSectionEntry(request.resource.data)
          && resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy
          && filedAtOwnPost(request.resource.data));
      allow delete:
        if isAdmin() || (approved() && resource.data.updatedBy == request.auth.uid);
    }

    // Border scan log: one document per truck scanned at a post. The border
    // offices belong to NSSS, so NSSS officers (and admins) read and write
    // them — a posted officer their own post's only, so a list query from such
    // an account must filter on border. An officer may remove a scan they
    // logged (the shift's own mistakes) — officerUid is the audit trail and
    // may never be reassigned.
    function validTruckScan(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.border is string && d.border.size() > 0
        && d.vehicleId is string && d.vehicleId.size() > 0
        && d.cargoClass in ['Goods of Interest','Food','Other']
        && d.commodity is string && d.commodity.size() > 0
        && d.transporter is string
        && d.doseNSvH is number && d.doseNSvH >= 0
        && d.result in ['Normal','Elevated','Alarm']
        // Anything above background must say what was done about it.
        && (d.result == 'Normal' || ('action' in d && d.action is string));
    }

    match /truckScans/{id} {
      allow read:   if isNSSS() && filesFor(resource.data.border);
      allow create: if isNSSS()
        && validTruckScan(request.resource.data)
        && request.resource.data.officerUid == request.auth.uid
        // An officer posted to an office logs that office's trucks only, so a
        // scan can never land under the wrong post's name.
        && filesFor(request.resource.data.border);
      // No client edits a scan — correcting one is remove-and-relog — but the
      // shape is still enforced for anything written out of band.
      allow update: if isAdmin()
        && validTruckScan(request.resource.data)
        && request.resource.data.officerUid == resource.data.officerUid;
      allow delete: if isAdmin()
        || (isNSSS() && resource.data.officerUid == request.auth.uid);
    }

    // Corrections to the two source inventories. The seeds ship with the app
    // and are never written; this collection is the overlay merged over them,
    // one document per corrected, removed or added record, keyed
    // '<inventory>:<record key>'. The registers belong to the National Source
    // Inventory section, so NSI officers (and admins) write them; every
    // signed-in officer reads, because both tabs render the merged view.
    //
    // Removal is a tombstone inside the document (removed == true), not a
    // delete: an accession register must keep the fact that a record was
    // withdrawn. Deleting the document is the separate "revert to what the
    // register says" action, which restores the seed value rather than losing
    // it, so it is allowed to the same officers.
    //
    // Only NSI opens the two inventory tabs, so only NSI reads the overlay.
    function validInventoryEdit(d, id) {
      return d.id == id
        && d.inventory in ['rais','verified']
        && d.key is string && d.key.size() > 0 && d.key.size() <= 64
        && d.id == d.inventory + ':' + d.key
        && d.patch is map && d.patch.size() <= 20
        && d.updatedAt is string
        && (!('removed' in d) || d.removed is bool)
        && (!('added' in d) || d.added is bool)
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    match /inventoryEdits/{id} {
      allow read:   if isNSI();
      allow create, update: if isNSI()
        && validInventoryEdit(request.resource.data, id)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isNSI();
    }

    // Border posts the NSSS section screens vehicles at. The border list is
    // managed by NSSS at head office (and admins): coordinators pick their
    // border when logging a daily screening count. Deactivating (active=false)
    // hides a border from the picker but keeps its logged history; deletes
    // stay admin-only. Readable by every officer — it is only the names of the
    // posts, and every section's screens name them.
    match /borders/{id} {
      allow read:   if approved();
      allow create, update: if isNSSSDesk()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Weekly manual metrics: any head-office officer may contribute their
    // section's numbers, but the document must keep its shape and history may
    // not be deleted by non-admins. One document per week holds every
    // section's typed figures, so the read cannot be split by section; the
    // sectional update shows each officer their own rows of it.
    match /weekMetrics/{week} {
      allow read:   if atHeadOffice();
      allow create, update: if atHeadOffice()
        && request.resource.data.week == week
        && request.resource.data.values is map;
      allow delete: if isAdmin();
    }

    // Work plan narrative: the Status / Comments / Action Points columns an
    // officer keeps against one output of the approved 2026 work plan, one
    // document per output id. The figures are never stored here — they are
    // derived from the registers and the weekly metrics — so a write may only
    // carry the three typed columns, and the document id must be the output id.
    function validWorkPlanNote(d, id) {
      return d.id == id
        && (!('status' in d) || d.status in ['Not Started','In Progress','Pending',
                                             'On Hold','Achieved','Cancelled'])
        && (!('comments' in d) || d.comments is string)
        && (!('actionPoints' in d) || d.actionPoints is string);
    }

    // The opening balance the plan year starts from — one document per year,
    // holding what each output had already achieved before the system began
    // counting it. It shifts every section's reported figures at once, so only
    // an admin may set it; everyone reads it because every figure on the
    // sectional update is measured from it.
    match /workPlanBaseline/{year} {
      allow read:   if atHeadOffice();
      allow create, update: if isAdmin()
        && request.resource.data.values is map
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // The sections' own changes to the approved plan — reworded outputs,
    // revised targets, rows added or retired, and the register each row counts
    // itself off. One document per plan year, holding ONLY the overlay: an
    // untouched output has no entry here and reports exactly as approved, so
    // clearing an entry is always a safe undo.
    //
    // Any head-office officer may write it, because a section maintains its
    // own rows and the report is where they do it. The document is a single
    // map covering every section, so rules cannot tell whose row moved — the
    // page gates each row on canEditSection, and every entry carries updatedBy
    // so a change is always attributable. Wholesale reset stays admin-only, as
    // does deleting the document.
    match /workPlanConfig/{year} {
      allow read:   if atHeadOffice();
      allow create, update: if atHeadOffice()
        && (!('outputs' in request.resource.data)
            || request.resource.data.outputs is map)
        && (!('subprogrammes' in request.resource.data)
            || request.resource.data.subprogrammes is map)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /workPlanNotes/{id} {
      allow read:   if atHeadOffice();
      allow create, update: if atHeadOffice()
        && validWorkPlanNote(request.resource.data, id)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read:   if atHeadOffice();
      allow create: if atHeadOffice() && request.resource.data.updatedBy == request.auth.uid;
      // Owners may edit/remove their own entries but never reassign them to
      // someone else (updatedBy is the audit trail); admins may do anything.
      allow update:
        if isAdmin() || (resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy);
      allow delete:
        if isAdmin() || resource.data.updatedBy == request.auth.uid;
    }

    // The dashboard rollup of the facilities register — the Overview's strip.
    match /aggregates/{doc} {
      allow read:  if seesRegister();
      allow write: if false;
    }

    match /config/{doc} {
      allow read:  if atHeadOffice();
      allow write: if isAdmin();
    }

    // Staff accounts. Role/section here are mirrored into Auth custom claims by
    // the onUserDocWrite function, so a doc with a missing/invalid pair must
    // never be writable — it would otherwise flow into someone's token.
    //
    // Two things write here. An administrator writes anything valid, which is
    // how an account is provisioned, approved, corrected or disabled. And a
    // person who has just created a sign-in writes their OWN account request,
    // exactly once, which is how self-service sign-up works — see
    // newAccountRequest in lib/rules/signup.ts.
    //
    // A request is boxed in on every side that matters: it is about the account
    // making it, it names that account's own verified email, it asks for
    // `officer` and never `admin`, it asks for ONE section and never the
    // cross-section 'All', and it must arrive `pending`, which is precisely the
    // state onUserDocWrite refuses to mint claims for. Approving it — clearing
    // `pending` — is an update, and updates stay an administrator's alone, so
    // nobody can approve themselves.
    function validAccountFields(d) {
      return d.role in ['admin','officer']
        && d.section in [
          'Authorisation & Standards','Inspectorate',
          'Nuclear Safety, Security & Safeguards','National Source Inventory','All'
        ]
        && (!('border' in d) || (d.border is string && d.border.size() <= 80))
        && (!('pending' in d) || d.pending is bool)
        && (!('disabled' in d) || d.disabled is bool);
    }

    function ownAccountRequest(d, uid) {
      return signedIn()
        && request.auth.uid == uid
        && d.uid == uid
        // The request must be about the sign-in making it. Case-folded because
        // the form lower-cases what was typed and the token need not.
        && d.email is string
        && d.email.lower() == request.auth.token.email.lower()
        && d.displayName is string
        && d.displayName.size() > 1 && d.displayName.size() <= 120
        && d.role == 'officer'
        && d.section in [
          'Authorisation & Standards','Inspectorate',
          'Nuclear Safety, Security & Safeguards','National Source Inventory'
        ]
        && d.pending == true
        && d.disabled == false
        && d.origin == 'self'
        // NSSS is the section posted to the inland offices, and its officers'
        // figures are filed against the office named here.
        && (d.section != 'Nuclear Safety, Security & Safeguards'
            || (d.border is string && d.border.size() > 0))
        && (!('border' in d) || (d.border is string && d.border.size() <= 80))
        // Approval-only fields may not be smuggled in on the request itself.
        && !('approvedAt' in d) && !('approvedBy' in d);
    }

    match /users/{uid} {
      allow read:  if isAdmin() || request.auth.uid == uid;
      allow create: if (isAdmin() && validAccountFields(request.resource.data))
        || ownAccountRequest(request.resource.data, uid);
      allow update: if isAdmin() && validAccountFields(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
