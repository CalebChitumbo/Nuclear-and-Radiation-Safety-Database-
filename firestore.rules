rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function section()  { return request.auth.token.section; }
    function isAdmin()  { return signedIn() && role() == 'admin'; }
    function isAS()     {
      return signedIn() && (
        section() == 'Authorisation & Standards' ||
        section() == 'All' || isAdmin()
      );
    }
    function isInsp() {
      return signedIn() && (
        section() == 'Inspectorate' ||
        section() == 'All' || isAdmin()
      );
    }

    function validFacility(d) {
      return d.name is string && d.name.size() > 0
        && d.province in ['Lusaka','Copperbelt','North-Western','Central','Northern',
                          'Luapula','Eastern','Western','Southern','Muchinga']
        && d.sector in ['Public','Private']
        && d.licensed is bool
        && d.stage is string;
    }

    function validEvent(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type is string
        && d.facilityName is string;
    }

    function validInspection(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.outcome in ['Compliant','Minor findings','Major findings','Non-compliant','N/A'];
    }

    function validInspectionRequest(d) {
      return d.facilityName is string && d.facilityName.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.status in ['Requested','Acknowledged','Assigned','In Progress',
                        'Report Ready','Closed','Cancelled']
        && d.timeline is list;
    }

    match /facilities/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && validFacility(request.resource.data);
      allow update: if isAS() && validFacility(request.resource.data);
      allow delete: if isAdmin();
    }

    match /licenceEvents/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && validEvent(request.resource.data);
      allow update: if isAS() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inspections/{id} {
      allow read:   if signedIn();
      allow create: if isInsp() && validInspection(request.resource.data);
      allow update: if isInsp() && validInspection(request.resource.data);
      allow delete: if isAdmin();
    }

    // Cross-section inspection requests: the Licensing (A&S) ↔ Inspectorate
    // handoff. Either section collaborates on the same document — Licensing
    // raises it and closes it once the report is actioned; the Inspectorate
    // acknowledges, assigns, progresses and completes it — so both may write,
    // guarded by a shape check. History (deletes) stays admin-only.
    match /inspectionRequests/{id} {
      allow read:   if signedIn();
      allow create: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow update: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    // RAIS licensing-status tracker: imported on the Licensing Status tab by
    // Authorisation & Standards officers; readable by any signed-in user.
    match /licenceWorkflows/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && request.resource.data.ran is string;
      allow update: if isAS() && request.resource.data.ran is string;
      allow delete: if isAdmin();
    }

    // Daily section log (Daily Updates tab). Any officer may log their day —
    // a numeric count against one of their section's metrics, or a free-text
    // note. Entries carry the reporting week so they roll straight up into the
    // weekly report. Owners may edit/remove their own lines (updatedBy is the
    // audit trail and may never be reassigned); admins may do anything.
    function validDailyEntry(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.section in ['Authorisation & Standards','Inspectorate',
                         'Nuclear Safety, Security & Safeguards','National Source Inventory']
        && d.kind in ['count','note'];
    }

    match /dailyEntries/{id} {
      allow read:   if signedIn();
      allow create: if signedIn()
        && validDailyEntry(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;
      allow update:
        if isAdmin() || (signedIn()
          && validDailyEntry(request.resource.data)
          && resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy);
      allow delete:
        if isAdmin() || (signedIn() && resource.data.updatedBy == request.auth.uid);
    }

    // Weekly manual metrics: any officer may contribute their section's
    // numbers, but the document must keep its shape and history may not be
    // deleted by non-admins.
    match /weekMetrics/{week} {
      allow read:   if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.week == week
        && request.resource.data.values is map;
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.updatedBy == request.auth.uid;
      // Owners may edit/remove their own entries but never reassign them to
      // someone else (updatedBy is the audit trail); admins may do anything.
      allow update:
        if isAdmin() || (resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy);
      allow delete:
        if isAdmin() || resource.data.updatedBy == request.auth.uid;
    }

    match /aggregates/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }

    match /config/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Staff accounts. Role/section here are mirrored into Auth custom claims by
    // the onUserDocWrite function, so a doc with a missing/invalid pair must
    // never be writable — it would otherwise flow into someone's token.
    match /users/{uid} {
      allow read:  if isAdmin() || request.auth.uid == uid;
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin','officer']
        && request.resource.data.section in [
          'Authorisation & Standards','Inspectorate',
          'Nuclear Safety, Security & Safeguards','National Source Inventory','All'
        ];
      allow delete: if isAdmin();
    }
  }
}
