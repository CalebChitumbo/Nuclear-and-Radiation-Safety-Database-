rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function section()  { return request.auth.token.section; }
    function isAdmin()  { return signedIn() && role() == 'admin'; }
    function isAS()     {
      return signedIn() && (
        section() == 'Authorisation & Standards' ||
        section() == 'All' || isAdmin()
      );
    }
    function isInsp() {
      return signedIn() && (
        section() == 'Inspectorate' ||
        section() == 'All' || isAdmin()
      );
    }
    function isNSSS() {
      return signedIn() && (
        section() == 'Nuclear Safety, Security & Safeguards' ||
        section() == 'All' || isAdmin()
      );
    }

    function validFacility(d) {
      return d.name is string && d.name.size() > 0
        && d.province in ['Lusaka','Copperbelt','North-Western','Central','Northern',
                          'Luapula','Eastern','Western','Southern','Muchinga']
        && d.sector in ['Public','Private']
        && d.licensed is bool
        && d.stage is string
        // 2026 status-list fields — optional for docs written before them.
        && (!('functional' in d) || d.functional is bool)
        && (!('category' in d) || d.category in ['Medical','Non-Medical'])
        && (!('stalled' in d) || d.stalled is bool)
        && (!('needsReview' in d) || d.needsReview is bool);
    }

    function validEvent(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type is string
        && d.facilityName is string;
    }

    function validInspection(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.outcome in ['Compliant','Minor findings','Major findings','Non-compliant','N/A'];
    }

    function validInspectionRequest(d) {
      return d.facilityName is string && d.facilityName.size() > 0
        && d.type in ['Routine Inspection','Follow-up','Pre-Authorisation','Investigation','Enforcement Action']
        && d.status in ['Requested','Acknowledged','Assigned','In Progress',
                        'Report Ready','Closed','Cancelled']
        && d.timeline is list;
    }

    match /facilities/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && validFacility(request.resource.data);
      allow update: if isAS() && validFacility(request.resource.data);
      allow delete: if isAdmin();
    }

    match /licenceEvents/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && validEvent(request.resource.data);
      allow update: if isAS() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inspections/{id} {
      allow read:   if signedIn();
      allow create: if isInsp() && validInspection(request.resource.data);
      allow update: if isInsp() && validInspection(request.resource.data);
      allow delete: if isAdmin();
    }

    // Cross-section inspection requests: the Licensing (A&S) ↔ Inspectorate
    // handoff. Either section collaborates on the same document — Licensing
    // raises it and closes it once the report is actioned; the Inspectorate
    // acknowledges, assigns, progresses and completes it — so both may write,
    // guarded by a shape check. History (deletes) stays admin-only.
    match /inspectionRequests/{id} {
      allow read:   if signedIn();
      allow create: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow update: if (isAS() || isInsp())
        && validInspectionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    // RAIS licensing-status tracker: imported on the Smart Status Update tab by
    // Authorisation & Standards officers; readable by any signed-in user.
    //
    // The `notes` trail (officer comments + automatic status history) is the
    // shared memory on an application — cross-section awareness is its point —
    // so ANY signed-in officer may APPEND to it: the write may touch nothing
    // but notes/updatedAt/updatedBy and may never shrink the trail. Everything
    // else on the record stays A&S-only.
    function notesAppendOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notes', 'updatedAt', 'updatedBy'])
        && request.resource.data.notes is list
        && (!('notes' in resource.data)
            || request.resource.data.notes.size() >= resource.data.notes.size());
    }

    match /licenceWorkflows/{id} {
      allow read:   if signedIn();
      allow create: if isAS() && request.resource.data.ran is string;
      allow update: if (isAS() && request.resource.data.ran is string)
        || (signedIn() && notesAppendOnly());
      allow delete: if isAdmin();
    }

    // Daily section log (Daily Updates tab). Any officer may log their day —
    // a numeric count against one of their section's metrics, or a free-text
    // note. Entries carry the reporting week so they roll straight up into the
    // weekly report. Owners may edit/remove their own lines (updatedBy is the
    // audit trail and may never be reassigned); admins may do anything.
    function validDailyEntry(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.section in ['Authorisation & Standards','Inspectorate',
                         'Nuclear Safety, Security & Safeguards','National Source Inventory']
        && d.kind in ['count','note'];
    }

    match /dailyEntries/{id} {
      allow read:   if signedIn();
      allow create: if signedIn()
        && validDailyEntry(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;
      allow update:
        if isAdmin() || (signedIn()
          && validDailyEntry(request.resource.data)
          && resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy);
      allow delete:
        if isAdmin() || (signedIn() && resource.data.updatedBy == request.auth.uid);
    }

    // Border scan log: one document per truck scanned at a post. The border
    // offices belong to NSSS, so NSSS officers (and admins) write them; every
    // signed-in officer may read, because the weekly report is assembled from
    // these rows. An officer may remove a scan they logged (the shift's own
    // mistakes) — officerUid is the audit trail and may never be reassigned.
    function validTruckScan(d) {
      return d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.week is string && d.week.size() > 0
        && d.border is string && d.border.size() > 0
        && d.vehicleId is string && d.vehicleId.size() > 0
        && d.cargoClass in ['Goods of Interest','Food','Other']
        && d.commodity is string && d.commodity.size() > 0
        && d.transporter is string
        && d.doseNSvH is number && d.doseNSvH >= 0
        && d.result in ['Normal','Elevated','Alarm']
        // Anything above background must say what was done about it.
        && (d.result == 'Normal' || ('action' in d && d.action is string));
    }

    match /truckScans/{id} {
      allow read:   if signedIn();
      allow create: if isNSSS()
        && validTruckScan(request.resource.data)
        && request.resource.data.officerUid == request.auth.uid;
      // No client edits a scan — correcting one is remove-and-relog — but the
      // shape is still enforced for anything written out of band.
      allow update: if isAdmin()
        && validTruckScan(request.resource.data)
        && request.resource.data.officerUid == resource.data.officerUid;
      allow delete: if isAdmin()
        || (isNSSS() && resource.data.officerUid == request.auth.uid);
    }

    // Border posts the NSSS section screens vehicles at. The border list is
    // managed by NSSS (and admins): coordinators pick their border when
    // logging a daily screening count. Deactivating (active=false) hides a
    // border from the picker but keeps its logged history; deletes stay
    // admin-only.
    match /borders/{id} {
      allow read:   if signedIn();
      allow create, update: if isNSSS()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Weekly manual metrics: any officer may contribute their section's
    // numbers, but the document must keep its shape and history may not be
    // deleted by non-admins.
    match /weekMetrics/{week} {
      allow read:   if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.week == week
        && request.resource.data.values is map;
      allow delete: if isAdmin();
    }

    // Work plan narrative: the Status / Comments / Action Points columns an
    // officer keeps against one output of the approved 2026 work plan, one
    // document per output id. The figures are never stored here — they are
    // derived from the registers and the weekly metrics — so a write may only
    // carry the three typed columns, and the document id must be the output id.
    function validWorkPlanNote(d, id) {
      return d.id == id
        && (!('status' in d) || d.status in ['Not Started','In Progress','Pending',
                                             'On Hold','Achieved','Cancelled'])
        && (!('comments' in d) || d.comments is string)
        && (!('actionPoints' in d) || d.actionPoints is string);
    }

    match /workPlanNotes/{id} {
      allow read:   if signedIn();
      allow create, update: if signedIn()
        && validWorkPlanNote(request.resource.data, id)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.updatedBy == request.auth.uid;
      // Owners may edit/remove their own entries but never reassign them to
      // someone else (updatedBy is the audit trail); admins may do anything.
      allow update:
        if isAdmin() || (resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedBy == resource.data.updatedBy);
      allow delete:
        if isAdmin() || resource.data.updatedBy == request.auth.uid;
    }

    match /aggregates/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }

    match /config/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Staff accounts. Role/section here are mirrored into Auth custom claims by
    // the onUserDocWrite function, so a doc with a missing/invalid pair must
    // never be writable — it would otherwise flow into someone's token.
    match /users/{uid} {
      allow read:  if isAdmin() || request.auth.uid == uid;
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin','officer']
        && request.resource.data.section in [
          'Authorisation & Standards','Inspectorate',
          'Nuclear Safety, Security & Safeguards','National Source Inventory','All'
        ];
      allow delete: if isAdmin();
    }
  }
}
